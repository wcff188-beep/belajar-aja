    // 5. STATE MANAGEMENT & LOCALSTORAGE PERSISTENCE
    // =========================================================================
    const STORAGE_KEY = 'akl10_smartlearn_state_v1';

    let appState = {
      activeView: 'materi',
      activeChapterId: 1,
      completedChapters: [],
      darkMode: false,
      pdaTransactions: [
        { ...PDA_PRESETS[0], uid: 1 },
        { ...PDA_PRESETS[1], uid: 2 },
        { ...PDA_PRESETS[3], uid: 3 }
      ],
      game: {
        cardIndex: 0,
        score: 0,
        streak: 0,
        answered: 0,
        correct: 0,
        isAnswered: false
      },
      quiz: {
        answers: {}, // { questionId: optionIndex }
        submitted: false
      }
    };

    function loadState() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          appState = {
            ...appState,
            ...parsed,
            game: { ...appState.game, ...(parsed.game || {}), isAnswered: false },
            quiz: { ...appState.quiz, ...(parsed.quiz || {}) }
          };
        } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          appState.darkMode = true;
        }
      } catch (err) {
        console.warn('Gagal memuat state dari localStorage:', err);
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (err) {
        console.warn('Gagal menyimpan state ke localStorage:', err);
      }
    }

    // =========================================================================
    // 6. UI HELPERS (TOAST, THEME, NAVIGATION, DRAWER)
    // =========================================================================
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const styles = {
        success: 'bg-emerald-600 text-white border-emerald-500',
        info: 'bg-slate-900 text-white border-slate-700',
        warning: 'bg-amber-500 text-slate-950 border-amber-400'
      };
      toast.className = `pointer-events-auto px-4 py-3 rounded-xl shadow-lg border text-xs sm:text-sm font-semibold flex items-center justify-between gap-3 animate-pop ${styles[type] || styles.info}`;
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(8px)';
        toast.style.transition = 'all 0.2s ease';
        setTimeout(() => toast.remove(), 220);
      }, 2800);
    }

    function applyTheme() {
      const html = document.documentElement;
      if (appState.darkMode) {
        html.classList.add('dark');
      } else {
        html.classList.remove('dark');
      }
    }

    document.getElementById('theme-toggle-btn').addEventListener('click', () => {
      appState.darkMode = !appState.darkMode;
      applyTheme();
      saveState();
      showToast(appState.darkMode ? 'Mode Gelap diaktifkan 🌙' : 'Mode Terang diaktifkan ☀️', 'info');
    });

    // Mobile Drawer Controls
    const sidebarEl = document.getElementById('chapter-sidebar');
    const backdropEl = document.getElementById('mobile-drawer-backdrop');

    document.getElementById('mobile-menu-btn').addEventListener('click', () => {
      sidebarEl.classList.remove('-translate-x-full');
      backdropEl.classList.remove('hidden');
    });

    function closeMobileDrawer() {
      sidebarEl.classList.add('-translate-x-full');
      backdropEl.classList.add('hidden');
    }

    // View Switching
    function switchView(viewName) {
      appState.activeView = viewName;
      saveState();

      document.querySelectorAll('.view-section').forEach(sec => sec.classList.add('hidden'));
      const target = document.getElementById(`view-${viewName}`);
      if (target) target.classList.remove('hidden');

      // Highlight active nav tabs
      document.querySelectorAll('.nav-tab').forEach(btn => {
        const isActive = btn.dataset.tab === viewName;
        if (isActive) {
          btn.className = btn.className
            .replace(/text-slate-600|dark:text-slate-300|hover:bg-white\/60|dark:hover:bg-slate-700\/60/g, '')
            .trim() + ' bg-white dark:bg-slate-900 text-emerald-600 dark:text-emerald-400 shadow-xs';
        } else {
          btn.className = btn.className
            .replace(/bg-white|dark:bg-slate-900|text-emerald-600|dark:text-emerald-400|shadow-xs/g, '')
            .trim() + ' text-slate-600 dark:text-slate-300 hover:bg-white/60 dark:hover:bg-slate-700/60';
        }
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // =========================================================================
    // 7. RENDER SIDEBAR & CHAPTER CONTENT
    // =========================================================================
    function renderSidebarAndProgress() {
      const total = CHAPTERS_DATA.length;
      const done = appState.completedChapters.length;
      const percent = Math.round((done / total) * 100);

      // Update Header Progress
      document.getElementById('header-progress-bar').style.width = `${percent}%`;
      document.getElementById('header-progress-text').textContent = `${done}/${total} Bab`;

      // Update Sidebar Progress
      document.getElementById('sidebar-percent').textContent = `${percent}%`;
      document.getElementById('sidebar-count').textContent = `${done} dari ${total} Bab`;
      document.getElementById('sidebar-progress-bar').style.width = `${percent}%`;

      const motEl = document.getElementById('sidebar-motivation');
      if (done === 0) motEl.textContent = 'Mulai pelajari Bab 1 untuk membangun fondasi akuntansimu!';
      else if (done < 4) motEl.textContent = 'Bagus! Teruskan langkahmu memahami dasar akuntansi.';
      else if (done < 8) motEl.textContent = 'Luar biasa! Lebih dari separuh materi sudah kamu kuasai.';
      else motEl.textContent = '🎉 Selamat! Semua 8 Bab Kelas 10 telah selesai dipelajari!';

      // Render Chapter List
      const listContainer = document.getElementById('sidebar-chapter-list');
      listContainer.innerHTML = CHAPTERS_DATA.map(ch => {
        const isCurrent = appState.activeView === 'materi' && appState.activeChapterId === ch.id;
        const isCompleted = appState.completedChapters.includes(ch.id);

        return `
          <button onclick="selectChapter(${ch.id})" class="w-full text-left p-3 rounded-xl transition flex items-start gap-3 border ${
            isCurrent
              ? 'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-400 dark:border-emerald-600 shadow-xs'
              : 'bg-transparent border-transparent hover:bg-slate-100 dark:hover:bg-slate-800/70'
          }">
            <div class="mt-0.5 w-6 h-6 rounded-lg flex items-center justify-center text-xs font-extrabold shrink-0 ${
              isCompleted
                ? 'bg-emerald-600 text-white'
                : isCurrent
                  ? 'bg-amber-400 text-slate-950'
                  : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
            }">
              ${isCompleted ? '✓' : ch.id}
