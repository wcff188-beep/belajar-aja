    function toggleCurrentChapterComplete() {
      const id = appState.activeChapterId;
      const idx = appState.completedChapters.indexOf(id);
      if (idx === -1) {
        appState.completedChapters.push(id);
        showToast(`Hebat! Bab ${id} ditandai selesai dipelajari 🎉`, 'success');
      } else {
        appState.completedChapters.splice(idx, 1);
        showToast(`Status selesai Bab ${id} dibatalkan`, 'info');
      }
      saveState();
      renderSidebarAndProgress();
      renderActiveChapter();
