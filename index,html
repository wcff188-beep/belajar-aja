    function addPresetTransaction(presetId) {
      const preset = PDA_PRESETS.find(p => p.id === presetId);
      if (!preset) return;
      appState.pdaTransactions.push({
        ...preset,
        uid: Date.now() + Math.random()
      });
      saveState();
      renderSimulatorTable();
      showToast(`Transaksi "${preset.label}" dicatat!`, 'success');
    }

    function handleCustomTransaction(e) {
      e.preventDefault();
      const type = document.getElementById('custom-tx-type').value;
      const desc = document.getElementById('custom-tx-desc').value.trim();
      const amt = parseInt(document.getElementById('custom-tx-amount').value, 10) || 0;
      if (!desc || amt <= 0) return;

      let tx = {
        uid: Date.now(),
        desc,
        kas: 0, piutang: 0, perlengkapan: 0, peralatan: 0,
        utang: 0, modal: 0, ketEkuitas: '-'
      };

      switch (type) {
        case 'modal_tunai':
          tx.kas = amt; tx.modal = amt; tx.ketEkuitas = 'Setoran Modal'; break;
        case 'beli_perlengkapan_tunai':
          tx.kas = -amt; tx.perlengkapan = amt; break;
        case 'beli_peralatan_kredit':
          tx.peralatan = amt; tx.utang = amt; break;
        case 'pendapatan_tunai':
          tx.kas = amt; tx.modal = amt; tx.ketEkuitas = 'Pendapatan Jasa'; break;
        case 'pendapatan_kredit':
          tx.piutang = amt; tx.modal = amt; tx.ketEkuitas = 'Pendapatan Jasa'; break;
        case 'bayar_beban':
          tx.kas = -amt; tx.modal = -amt; tx.ketEkuitas = 'Beban Operasional'; break;
        case 'bayar_utang':
          tx.kas = -amt; tx.utang = -amt; break;
        case 'prive':
          tx.kas = -amt; tx.modal = -amt; tx.ketEkuitas = 'Prive Pemilik'; break;
      }

      appState.pdaTransactions.push(tx);
      document.getElementById('custom-tx-desc').value = '';
      saveState();
      renderSimulatorTable();
      showToast('Transaksi kustom berhasil dicatat!', 'success');
    }

    function deleteSimulatorRow(uid) {
      appState.pdaTransactions = appState.pdaTransactions.filter(t => t.uid !== uid);
      saveState();
      renderSimulatorTable();
      showToast('Baris transaksi dihapus', 'info');
    }

    function resetSimulator() {
      appState.pdaTransactions = [];
      saveState();
      renderSimulatorTable();
      showToast('Tabel Persamaan Dasar Akuntansi dikosongkan', 'warning');
    }

    function renderSimulatorTable() {
      const tbody = document.getElementById('sim-table-body');
      const tfoot = document.getElementById('sim-table-foot');
      const txs = appState.pdaTransactions;

      document.getElementById('sim-tx-count').textContent = `${txs.length} Transaksi Tercatat`;

      let sumKas = 0, sumPiutang = 0, sumPerlengkapan = 0, sumPeralatan = 0;
      let sumUtang = 0, sumModal = 0;

      if (txs.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="10" class="p-8 text-center font-sans text-sm text-slate-400">
              Belum ada transaksi tercatat. Klik salah satu tombol transaksi di atas untuk memulai simulasi!
            </td>
          </tr>
        `;
      } else {
        tbody.innerHTML = txs.map((t, index) => {
          sumKas += t.kas;
          sumPiutang += t.piutang;
          sumPerlengkapan += t.perlengkapan;
          sumPeralatan += t.peralatan;
          sumUtang += t.utang;
          sumModal += t.modal;

          const colorCell = (val) => val < 0 ? 'text-rose-600 dark:text-rose-400' : val > 0 ? 'text-slate-800 dark:text-slate-100' : 'text-slate-400';

          return `
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
              <td class="p-3 text-center text-slate-400">${index + 1}</td>
              <td class="p-3 font-sans font-medium text-slate-800 dark:text-slate-200">${t.desc}</td>
              <td class="p-3 text-right ${colorCell(t.kas)}">${formatRupiah(t.kas)}</td>
              <td class="p-3 text-right ${colorCell(t.piutang)}">${formatRupiah(t.piutang)}</td>
              <td class="p-3 text-right ${colorCell(t.perlengkapan)}">${formatRupiah(t.perlengkapan)}</td>
              <td class="p-3 text-right ${colorCell(t.peralatan)}">${formatRupiah(t.peralatan)}</td>
              <td class="p-3 text-right ${colorCell(t.utang)}">${formatRupiah(t.utang)}</td>
              <td class="p-3 text-right ${colorCell(t.modal)}">${formatRupiah(t.modal)}</td>
              <td class="p-3 font-sans text-xs text-slate-500 dark:text-slate-400">${t.ketEkuitas}</td>
              <td class="p-3 text-center">
                <button onclick="deleteSimulatorRow(${t.uid})" title="Hapus baris" class="p-1.5 rounded-lg text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/50 transition">
                  ✕
                </button>
              </td>
            </tr>
          `;
        }).join('');
      }

      tfoot.innerHTML = `
        <tr>
          <td colspan="2" class="p-3.5 font-sans text-right uppercase tracking-wider text-slate-700 dark:text-slate-200">Saldo Akhir Akun:</td>
          <td class="p-3.5 text-right text-emerald-700 dark:text-emerald-400">${formatRupiahFull(sumKas)}</td>
          <td class="p-3.5 text-right text-emerald-700 dark:text-emerald-400">${formatRupiahFull(sumPiutang)}</td>
          <td class="p-3.5 text-right text-emerald-700 dark:text-emerald-400">${formatRupiahFull(sumPerlengkapan)}</td>
          <td class="p-3.5 text-right text-emerald-700 dark:text-emerald-400">${formatRupiahFull(sumPeralatan)}</td>
          <td class="p-3.5 text-right text-amber-700 dark:text-amber-400">${formatRupiahFull(sumUtang)}</td>
          <td class="p-3.5 text-right text-blue-700 dark:text-blue-400">${formatRupiahFull(sumModal)}</td>
          <td colspan="2" class="p-3.5 font-sans text-xs text-slate-400"></td>
        </tr>
      `;

      // Update Summary Cards
      const totalAset = sumKas + sumPiutang + sumPerlengkapan + sumPeralatan;
      const totalPasiva = sumUtang + sumModal;
      const diff = totalAset - totalPasiva;

      document.getElementById('sim-total-aset').textContent = formatRupiahFull(totalAset);
      document.getElementById('sim-total-pasiva').textContent = formatRupiahFull(totalPasiva);

      const balCard = document.getElementById('sim-balance-card');
      const balStatus = document.getElementById('sim-balance-status');
      const balDiff = document.getElementById('sim-balance-diff');

      if (diff === 0) {
        balCard.className = 'rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 p-5 border-2 border-emerald-500 shadow-xs flex flex-col justify-between';
        balStatus.textContent = '✅ SEIMBANG (BALANCE)';
        balStatus.className = 'text-xl sm:text-2xl font-extrabold text-emerald-700 dark:text-emerald-300 mt-1';
        balDiff.textContent = 'Selisih: Rp 0 (Aset = Liabilitas + Ekuitas)';
      } else {
        balCard.className = 'rounded-2xl bg-rose-50 dark:bg-rose-950/50 p-5 border-2 border-rose-500 shadow-xs flex flex-col justify-between';
        balStatus.textContent = '⚠️ TIDAK SEIMBANG';
        balStatus.className = 'text-xl sm:text-2xl font-extrabold text-rose-700 dark:text-rose-300 mt-1';
        balDiff.textContent = `Selisih: ${formatRupiahFull(diff)}`;
      }
    }

    // =========================================================================
    // 9. MINI-GAME DEBIT & KREDIT
    // =========================================================================
    function renderGameCard() {
      const g = appState.game;
      const card = DEBIT_CREDIT_CARDS[g.cardIndex % DEBIT_CREDIT_CARDS.length];

      document.getElementById('game-score').textContent = g.score;
      document.getElementById('game-streak').textContent = `${g.streak} 🔥`;
      const acc = g.answered > 0 ? Math.round((g.correct / g.answered) * 100) : 0;
      document.getElementById('game-accuracy').textContent = `${acc}%`;

      document.getElementById('game-card-counter').textContent = `Kartu #${(g.cardIndex % DEBIT_CREDIT_CARDS.length) + 1} dari ${DEBIT_CREDIT_CARDS.length}`;
      document.getElementById('game-account-category').textContent = `Kelompok: ${card.category}`;
      document.getElementById('game-account-name').textContent = card.account;
      document.getElementById('game-scenario-hint').textContent = `Ilustrasi: ${card.hint}`;

      const condBadge = document.getElementById('game-condition-badge');
      condBadge.textContent = card.condition;
      if (card.condition.includes('+')) {
        condBadge.className = 'inline-block px-4 py-2 rounded-xl text-base sm:text-lg font-bold bg-emerald-100 text-emerald-900 dark:bg-emerald-500/20 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/30';
      } else {
        condBadge.className = 'inline-block px-4 py-2 rounded-xl text-base sm:text-lg font-bold bg-rose-100 text-rose-900 dark:bg-rose-500/20 dark:text-rose-300 border border-rose-300 dark:border-rose-500/30';
      }

      document.getElementById('game-choice-buttons').classList.remove('hidden');
      document.getElementById('game-feedback-box').classList.add('hidden');
      g.isAnswered = false;
    }

    function submitGameAnswer(choice) {
      const g = appState.game;
      if (g.isAnswered) return;
      g.isAnswered = true;

      const card = DEBIT_CREDIT_CARDS[g.cardIndex % DEBIT_CREDIT_CARDS.length];
      const isCorrect = choice === card.answer;

      g.answered += 1;
      if (isCorrect) {
        g.correct += 1;
        g.streak += 1;
        g.score += 10 + (g.streak >= 3 ? 5 : 0);
      } else {
        g.streak = 0;
      }
      saveState();

      // Update scoreboard immediately
      document.getElementById('game-score').textContent = g.score;
      document.getElementById('game-streak').textContent = `${g.streak} 🔥`;
      document.getElementById('game-accuracy').textContent = `${Math.round((g.correct / g.answered) * 100)}%`;

      // Show Feedback
      document.getElementById('game-choice-buttons').classList.add('hidden');
      const fbBox = document.getElementById('game-feedback-box');
      const fbTitle = document.getElementById('game-feedback-title');
      const fbRule = document.getElementById('game-feedback-rule');
      const fbExp = document.getElementById('game-feedback-explanation');

      fbBox.classList.remove('hidden');
      if (isCorrect) {
        fbBox.className = 'rounded-2xl p-5 text-left space-y-2.5 animate-pop bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-400 text-emerald-950 dark:text-emerald-100';
        fbTitle.textContent = '🎉 Tepat Sekali! Jawabanmu Benar!';
        fbRule.textContent = `Posisi: ${card.answer}`;
        fbRule.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-lg bg-emerald-600 text-white';
      } else {
        fbBox.className = 'rounded-2xl p-5 text-left space-y-2.5 animate-pop bg-rose-50 dark:bg-rose-950/60 border border-rose-400 text-rose-950 dark:text-rose-100';
        fbTitle.textContent = `❌ Kurang Tepat! Jawaban yang Benar: ${card.answer}`;
        fbRule.textContent = `Seharusnya: ${card.answer}`;
        fbRule.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-lg bg-rose-600 text-white';
      }
      fbExp.textContent = card.explanation;
    }

    function nextGameCard() {
      appState.game.cardIndex += 1;
      saveState();
      renderGameCard();
    }

    function resetGameStats() {
      appState.game = { cardIndex: 0, score: 0, streak: 0, answered: 0, correct: 0, isAnswered: false };
      saveState();
      renderGameCard();
      showToast('Skor latihan Debit & Kredit direset', 'info');
    }

    // =========================================================================
    // 10. KUIS EVALUASI KELAS 10 (10 SOAL + PEMBAHASAN)
    // =========================================================================
    function renderQuiz() {
      const container = document.getElementById('quiz-questions-container');
      const qState = appState.quiz;
      const letters = ['A', 'B', 'C', 'D'];

      const answeredCount = Object.keys(qState.answers).length;
      document.getElementById('quiz-answered-count').textContent = `${answeredCount} / ${QUIZ_QUESTIONS.length}`;

      container.innerHTML = QUIZ_QUESTIONS.map((q, idx) => {
        const selectedOpt = qState.answers[q.id];
        const isSubmitted = qState.submitted;

        return `
          <div class="rounded-2xl bg-white dark:bg-slate-900 p-5 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <span class="text-xs font-extrabold px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">Soal #${idx + 1}</span>
              <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-400">${q.bab}</span>
            </div>

            <p class="text-sm sm:text-base font-semibold text-slate-900 dark:text-white leading-relaxed">${q.question}</p>

            <div class="grid grid-cols-1 gap-2.5">
              ${q.options.map((optText, optIdx) => {
                const isSelected = selectedOpt === optIdx;
                const isCorrectOpt = q.correct === optIdx;

                let btnClass = 'border-slate-200 dark:border-slate-700 bg-slate-50/70 dark:bg-slate-800/50 hover:border-emerald-400 text-slate-700 dark:text-slate-200';
                let badgeClass = 'bg-white dark:bg-slate-700 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-600';

                if (!isSubmitted && isSelected) {
                  btnClass = 'border-emerald-500 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-950 dark:text-emerald-100 ring-2 ring-emerald-500/30';
                  badgeClass = 'bg-emerald-600 text-white border-emerald-600';
                } else if (isSubmitted) {
                  if (isCorrectOpt) {
                    btnClass = 'border-emerald-500 bg-emerald-50 dark:bg-emerald-950/60 text-emerald-950 dark:text-emerald-100';
                    badgeClass = 'bg-emerald-600 text-white border-emerald-600';
                  } else if (isSelected && !isCorrectOpt) {
                    btnClass = 'border-rose-500 bg-rose-50 dark:bg-rose-950/60 text-rose-950 dark:text-rose-100';
                    badgeClass = 'bg-rose-600 text-white border-rose-600';
                  }
                }

                return `
                  <button type="button" ${isSubmitted ? 'disabled' : ''} onclick="selectQuizOption(${q.id}, ${optIdx})" class="w-full text-left p-3.5 rounded-xl border transition flex items-center gap-3 ${btnClass} ${isSubmitted ? 'cursor-default' : 'cursor-pointer'}">
                    <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-extrabold shrink-0 ${badgeClass}">${letters[optIdx]}</span>
                    <span class="text-xs sm:text-sm font-medium flex-1">${optText}</span>
                    ${isSubmitted && isCorrectOpt ? '<span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">✓ Benar</span>' : ''}
                    ${isSubmitted && isSelected && !isCorrectOpt ? '<span class="text-xs font-bold text-rose-600 dark:text-rose-400">✕ Jawabanmu</span>' : ''}
                  </button>
                `;
              }).join('')}
            </div>

            ${isSubmitted ? `
              <div class="mt-3 p-4 rounded-xl bg-amber-50/90 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/60 text-xs sm:text-sm text-slate-700 dark:text-slate-200">
                <strong class="text-amber-800 dark:text-amber-300">💡 Pembahasan:</strong> ${q.explanation}
              </div>
            ` : ''}
          </div>
        `;
      }).join('');

      // Result Banner & Submit Bar Visibility
      const resultBanner = document.getElementById('quiz-result-banner');
      const submitBar = document.getElementById('quiz-submit-bar');

      if (qState.submitted) {
        submitBar.classList.add('hidden');
        let correctTotal = 0;
        QUIZ_QUESTIONS.forEach(q => {
          if (qState.answers[q.id] === q.correct) correctTotal++;
        });
        const finalScore = correctTotal * 10;
        const passed = finalScore >= 75;

        resultBanner.classList.remove('hidden');
        resultBanner.className = `rounded-3xl p-6 sm:p-8 border-2 shadow-lg animate-pop ${
          passed
            ? 'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-500 text-emerald-950 dark:text-emerald-100'
            : 'bg-amber-50 dark:bg-amber-950/50 border-amber-500 text-amber-950 dark:text-amber-100'
        }`;

        resultBanner.innerHTML = `
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-1.5">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider ${
                passed ? 'bg-emerald-600 text-white' : 'bg-amber-500 text-slate-950'
              }">
                ${passed ? '🏆 KOMPETEN / LULUS KKTP (≥ 75)' : '📚 PERLU PENGUATAN MATERI (< 75)'}
              </span>
              <h2 class="text-2xl sm:text-3xl font-extrabold">Nilai Akhir Kamu: <span class="font-mono">${finalScore}</span> / 100</h2>
              <p class="text-sm opacity-90">Kamu menjawab benar <strong>${correctTotal} dari 10 soal</strong>. Gulir ke bawah untuk membaca pembahasan lengkap setiap nomor!</p>
            </div>
            <button onclick="resetQuiz()" class="px-5 py-3 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold text-sm hover:opacity-90 transition shrink-0">
              Kerjakan Ulang Kuis
            </button>
          </div>
        `;
      } else {
        resultBanner.classList.add('hidden');
        submitBar.classList.remove('hidden');
      }
    }

    function selectQuizOption(questionId, optionIndex) {
      if (appState.quiz.submitted) return;
      appState.quiz.answers[questionId] = optionIndex;
      saveState();
      renderQuiz();
    }

    function submitQuiz() {
      const answeredCount = Object.keys(appState.quiz.answers).length;
      if (answeredCount < QUIZ_QUESTIONS.length) {
        showToast(`Masih ada ${QUIZ_QUESTIONS.length - answeredCount} soal yang belum dijawab!`, 'warning');
        return;
      }
      appState.quiz.submitted = true;
      saveState();
      renderQuiz();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      showToast('Kuis selesai! Nilai akhir & pembahasan telah ditampilkan.', 'success');
    }

    function resetQuiz() {
      appState.quiz = { answers: {}, submitted: false };
      saveState();
      renderQuiz();
      showToast('Kuis direset. Silakan kerjakan kembali!', 'info');
    }

    // =========================================================================
    // 11. INITIALIZATION ON PAGE LOAD
    // =========================================================================
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      applyTheme();
      renderSidebarAndProgress();
      renderActiveChapter();
      renderSimulatorPresets();
      renderSimulatorTable();
      renderGameCard();
      renderQuiz();
      switchView(appState.activeView || 'materi');
    });
  </script>
</body>
</html>
