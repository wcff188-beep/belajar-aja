    function formatRupiah(num) {
      if (num === 0) return '-';
      const absVal = Math.abs(num).toLocaleString('id-ID');
      return num < 0 ? `(Rp ${absVal})` : `Rp ${absVal}`;
    }

    function formatRupiahFull(num) {
      const absVal = Math.abs(num).toLocaleString('id-ID');
      return num < 0 ? `-Rp ${absVal}` : `Rp ${absVal}`;
    }

