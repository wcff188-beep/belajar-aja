<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AKL-10 SmartLearn | Portal Belajar Akuntansi SMK Kelas 10</title>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace'],
          },
          colors: {
            emerald: {
              50: '#ecfdf5',
              100: '#d1fae5',
              200: '#a7f3d0',
              300: '#6ee7b7',
              400: '#34d399',
              500: '#10b981',
              600: '#059669',
              700: '#047857',
              800: '#065f46',
              900: '#064e3b',
            },
            navy: {
              800: '#1e293b',
              900: '#0f172a',
              950: '#090d16',
            }
          }
        }
      }
    };
  </script>
  <style>
    /* Custom scrollbar & utility styling */
    body {
      font-family: 'Inter', sans-serif;
    }
    .tabular-nums {
      font-variant-numeric: tabular-nums;
    }
    /* Smooth subtle scrollbars */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.4);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.7);
    }
    @keyframes popIn {
      0% { transform: scale(0.95); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .animate-pop {
      animation: popIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200 min-h-screen flex flex-col">

  <!-- Toast Notification Banner (Replaces alert) -->
  <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none max-w-sm w-full px-4 sm:px-0"></div>

  <!-- Top Header Navigation -->
  <header class="sticky top-0 z-40 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
      <!-- Left: Mobile Menu Button + Brand -->
      <div class="flex items-center gap-3">
        <button id="mobile-menu-btn" type="button" aria-label="Buka Daftar Bab" class="lg:hidden p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-emerald-50 dark:hover:bg-emerald-900/30 hover:text-emerald-600 transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <div class="flex items-center gap-2.5 cursor-pointer" onclick="switchView('materi')">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-600 to-teal-700 flex items-center justify-center text-white font-extrabold text-lg shadow-md shadow-emerald-600/20 border border-emerald-400/30">
            AK
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-extrabold text-base sm:text-lg tracking-tight text-slate-900 dark:text-white">AKL<span class="text-emerald-600 dark:text-emerald-400">Smart</span></span>
              <span class="hidden sm:inline-block text-[11px] font-semibold px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300 border border-amber-200 dark:border-amber-500/30">Kelas 10 • Fase E</span>
            </div>
            <p class="text-[11px] text-slate-500 dark:text-slate-400 hidden sm:block">Dasar-Dasar Akuntansi & Keuangan Lembaga</p>
          </div>
        </div>
      </div>

      <!-- Center: Main Mode Tabs (Desktop) -->
      <nav class="hidden md:flex items-center bg-slate-100 dark:bg-slate-800/90 p-1 rounded-xl border border-slate-200/80 dark:border-slate-700/80">
        <button onclick="switchView('materi')" data-tab="materi" class="nav-tab px-3.5 py-1.5 rounded-lg text-sm font-semibold transition flex items-center gap-1.5">
          <span>📚</span> Materi (8 Bab)
        </button>
        <button onclick="switchView('simulator')" data-tab="simulator" class="nav-tab px-3.5 py-1.5 rounded-lg text-sm font-semibold transition flex items-center gap-1.5">
          <span>⚖️</span> Simulator PDA
        </button>
        <button onclick="switchView('game')" data-tab="game" class="nav-tab px-3.5 py-1.5 rounded-lg text-sm font-semibold transition flex items-center gap-1.5">
          <span>⚡</span> Debit & Kredit
        </button>
        <button onclick="switchView('kuis')" data-tab="kuis" class="nav-tab px-3.5 py-1.5 rounded-lg text-sm font-semibold transition flex items-center gap-1.5">
          <span>🏆</span> Kuis Evaluasi
        </button>
      </nav>

      <!-- Right: Progress Pill & Dark Mode Toggle -->
      <div class="flex items-center gap-2.5">
        <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/60">
          <div class="w-16 h-2 bg-emerald-200 dark:bg-emerald-900 rounded-full overflow-hidden">
            <div id="header-progress-bar" class="h-full bg-emerald-600 dark:bg-emerald-400 transition-all duration-300" style="width: 0%"></div>
          </div>
          <span id="header-progress-text" class="text-xs font-bold text-emerald-700 dark:text-emerald-300 tabular-nums">0/8 Bab</span>
        </div>

        <button id="theme-toggle-btn" type="button" aria-label="Ganti Tema Gelap/Terang" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-amber-400 hover:bg-slate-200 dark:hover:bg-slate-700 transition border border-slate-200 dark:border-slate-700">
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="icon-sun" class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="icon-moon" class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Mode Navigation Bar -->
    <div class="md:hidden flex items-center gap-1.5 px-3 py-2 bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 overflow-x-auto">
      <button onclick="switchView('materi')" data-tab="materi" class="nav-tab shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">
        <span>📚</span> Materi (8 Bab)
      </button>
      <button onclick="switchView('simulator')" data-tab="simulator" class="nav-tab shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">
        <span>⚖️</span> Simulator PDA
      </button>
      <button onclick="switchView('game')" data-tab="game" class="nav-tab shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">
        <span>⚡</span> Debit/Kredit
      </button>
      <button onclick="switchView('kuis')" data-tab="kuis" class="nav-tab shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center gap-1">
        <span>🏆</span> Kuis (10 Soal)
      </button>
    </div>
  </header>

  <!-- Mobile Sidebar Drawer Overlay -->
  <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-40 hidden lg:hidden" onclick="closeMobileDrawer()"></div>

  <!-- Main Workspace Layout -->
  <div class="max-w-7xl w-full mx-auto flex-1 flex relative">

    <!-- Sidebar Navigation (8 Chapters + Progress Tracker) -->
    <aside id="chapter-sidebar" class="fixed lg:sticky top-0 lg:top-16 left-0 z-50 lg:z-30 w-80 max-w-[85vw] h-screen lg:h-[calc(100vh-4rem)] bg-white dark:bg-slate-900 border-r border-slate-200 dark:border-slate-800 flex flex-col transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out shadow-xl lg:shadow-none">
      <!-- Sidebar Header & Progress Card -->
      <div class="p-4 border-b border-slate-200 dark:border-slate-800 bg-gradient-to-br from-slate-900 to-slate-800 text-white">
        <div class="flex items-center justify-between mb-2">
          <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Progres Belajar Siswa</span>
          <button onclick="closeMobileDrawer()" class="lg:hidden p-1 rounded-lg text-slate-300 hover:text-white hover:bg-slate-700">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="flex items-end justify-between mb-1.5">
          <div>
            <span id="sidebar-percent" class="text-2xl font-extrabold text-emerald-400 tabular-nums">0%</span>
            <span class="text-xs text-slate-300 ml-1">Selesai</span>
          </div>
          <span id="sidebar-count" class="text-xs font-medium text-slate-300 tabular-nums">0 dari 8 Bab</span>
        </div>
        <div class="w-full h-2.5 bg-slate-700 rounded-full overflow-hidden">
          <div id="sidebar-progress-bar" class="h-full bg-gradient-to-r from-emerald-500 to-amber-400 transition-all duration-500 rounded-full" style="width: 0%"></div>
        </div>
        <p id="sidebar-motivation" class="text-[11px] text-slate-300 mt-2">Mulai pelajari Bab 1 untuk membangun fondasi akuntansimu!</p>
      </div>

      <!-- Chapter List -->
      <div class="flex-1 overflow-y-auto p-3 space-y-1.5" id="sidebar-chapter-list">
        <!-- Populated dynamically by JS -->
      </div>

      <!-- Sidebar Footer: Interactive Practice Shortcuts -->
      <div class="p-3 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/80 space-y-1.5">
        <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-2">Zona Praktik Interaktif</p>
        <button onclick="switchView('simulator'); closeMobileDrawer();" class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800/60 transition">
          <span>⚖️ Simulator Persamaan Dasar</span>
          <span>→</span>
        </button>
        <button onclick="switchView('game'); closeMobileDrawer();" class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900/50 border border-amber-200 dark:border-amber-800/50 transition">
          <span>⚡ Latihan Debit & Kredit</span>
          <span>→</span>
        </button>
        <button onclick="switchView('kuis'); closeMobileDrawer();" class="w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 border border-slate-200 dark:border-slate-700 transition">
          <span>🏆 Kuis Evaluasi (10 Soal)</span>
          <span>→</span>
        </button>
      </div>
    </aside>

    <!-- Main Dynamic Content Area -->
    <main class="flex-1 min-w-0 p-4 sm:p-6 lg:p-8 pb-20">

      <!-- ==================== VIEW 1: MATERI PEMBELAJARAN (8 BAB) ==================== -->
      <section id="view-materi" class="view-section space-y-6 animate-pop">
        <!-- Chapter Hero Banner -->
        <div id="chapter-hero" class="rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-950 text-white p-6 sm:p-8 shadow-lg border border-slate-700/80 relative overflow-hidden">
          <div class="absolute -right-10 -top-10 w-48 h-48 rounded-full bg-emerald-500/10 blur-2xl pointer-events-none"></div>
          <div class="absolute right-10 bottom-0 w-32 h-32 rounded-full bg-amber-400/10 blur-xl pointer-events-none"></div>
          
          <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="space-y-2 max-w-2xl">
              <div class="flex flex-wrap items-center gap-2">
                <span id="hero-bab-badge" class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">BAB 1</span>
                <span id="hero-read-time" class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-800/80 text-slate-300 border border-slate-700">⏱️ Estimasi 15 Menit</span>
                <span id="hero-status-pill" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-500/20 text-amber-300 border border-amber-400/30">Belum Selesai</span>
              </div>
              <h1 id="hero-title" class="text-2xl sm:text-3xl font-extrabold tracking-tight leading-snug">Judul Bab</h1>
              <p id="hero-subtitle" class="text-sm sm:text-base text-slate-300 leading-relaxed">Subjudul bab pembelajaran.</p>
            </div>

            <div class="shrink-0 flex sm:flex-row md:flex-col gap-2">
              <button id="btn-toggle-complete" onclick="toggleCurrentChapterComplete()" class="px-4 py-3 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2 shadow-md cursor-pointer">
                <!-- Populated dynamically -->
              </button>
            </div>
          </div>
        </div>

        <!-- Learning Objectives Box -->
        <div class="rounded-2xl bg-emerald-50/80 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/60 p-5">
          <h2 class="text-sm font-extrabold uppercase tracking-wider text-emerald-800 dark:text-emerald-300 flex items-center gap-2 mb-3">
            <span>🎯</span> Tujuan Pembelajaran (Capaian Fase E)
          </h2>
          <ul id="chapter-objectives" class="grid sm:grid-cols-2 gap-2.5 text-sm text-slate-700 dark:text-slate-200">
            <!-- Populated dynamically -->
          </ul>
        </div>

        <!-- Main Chapter Content -->
        <article id="chapter-body" class="space-y-6">
          <!-- Populated dynamically with rich structured HTML -->
        </article>

        <!-- Chapter Summary / Key Takeaways -->
        <div class="rounded-2xl bg-amber-50/80 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-800/50 p-5 sm:p-6">
          <h3 class="text-base font-extrabold text-amber-900 dark:text-amber-300 flex items-center gap-2 mb-3">
            <span>📌</span> Rangkuman Poin Penting Bab Ini
          </h3>
          <ul id="chapter-takeaways" class="space-y-2 text-sm text-slate-700 dark:text-slate-200 list-disc pl-5">
            <!-- Populated dynamically -->
          </ul>
        </div>

        <!-- Bottom Chapter Navigation Bar -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
          <button id="btn-prev-chapter" onclick="navigateChapter(-1)" class="px-5 py-3 rounded-xl font-semibold text-sm bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 transition flex items-center justify-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed">
            <span>←</span> Bab Sebelumnya
          </button>

          <button onclick="toggleCurrentChapterComplete()" id="btn-bottom-complete" class="px-5 py-3 rounded-xl font-bold text-sm transition flex items-center justify-center gap-2 shadow-xs">
            <!-- Dynamic text -->
          </button>

          <button id="btn-next-chapter" onclick="navigateChapter(1)" class="px-5 py-3 rounded-xl font-semibold text-sm bg-emerald-600 hover:bg-emerald-700 text-white transition flex items-center justify-center gap-2 shadow-sm">
            Bab Selanjutnya <span>→</span>
          </button>
        </div>
      </section>

      <!-- ==================== VIEW 2: SIMULATOR PERSAMAAN DASAR AKUNTANSI ==================== -->
      <section id="view-simulator" class="view-section hidden space-y-6 animate-pop">
        <!-- Header Banner -->
        <div class="rounded-2xl bg-gradient-to-r from-slate-900 to-emerald-900 text-white p-6 sm:p-8 shadow-lg border border-slate-700">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-amber-400/20 text-amber-300 border border-amber-400/30 mb-2">LABORATORIUM VIRTUAL AKUNTANSI</span>
              <h1 class="text-2xl sm:text-3xl font-extrabold">Simulator Persamaan Dasar Akuntansi (PDA)</h1>
              <p class="text-sm text-slate-300 mt-1">Studi Kasus: <strong class="text-white">Studio Desain & Digital "Kreativa Muda"</strong>. Klik transaksi untuk melihat keseimbangan <span class="font-mono text-emerald-300">Aset = Liabilitas + Ekuitas</span> secara real-time!</p>
            </div>
            <button onclick="resetSimulator()" class="self-start md:self-center px-4 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-sm font-bold transition shadow-md flex items-center gap-2 shrink-0">
              <span>🔄</span> Reset Tabel Transaksi
            </button>
          </div>
        </div>

        <!-- Real-time Balance Indicator Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Total Aset -->
          <div class="rounded-2xl bg-white dark:bg-slate-900 p-5 border border-slate-200 dark:border-slate-800 shadow-xs">
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
              <span>Sisi Kiri: Total Aset (Harta)</span>
              <span class="px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-900/50 text-emerald-700 dark:text-emerald-300">AKTIVA</span>
            </div>
            <div id="sim-total-aset" class="text-2xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono tabular-nums mt-1">Rp 0</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Kas + Piutang + Perlengkapan + Peralatan</p>
          </div>

          <!-- Total Liabilitas + Ekuitas -->
          <div class="rounded-2xl bg-white dark:bg-slate-900 p-5 border border-slate-200 dark:border-slate-800 shadow-xs">
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1">
              <span>Sisi Kanan: Liabilitas + Ekuitas</span>
              <span class="px-2 py-0.5 rounded bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300">PASIVA</span>
            </div>
            <div id="sim-total-pasiva" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white font-mono tabular-nums mt-1">Rp 0</div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Utang Usaha + Modal Akhir Pemilik</p>
          </div>

          <!-- Balance Status Indicator -->
          <div id="sim-balance-card" class="rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 p-5 border-2 border-emerald-500 shadow-xs flex flex-col justify-between">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">Status Keseimbangan</span>
              <span class="w-3 h-3 rounded-full bg-emerald-500 animate-ping"></span>
            </div>
            <div id="sim-balance-status" class="text-xl sm:text-2xl font-extrabold text-emerald-700 dark:text-emerald-300 mt-1">
              ✅ SEIMBANG (BALANCE)
            </div>
            <p id="sim-balance-diff" class="text-xs text-emerald-700 dark:text-emerald-400 mt-2 font-medium">Selisih: Rp 0 (Akurat 100%)</p>
          </div>
        </div>

        <!-- Preset Transaction Buttons -->
        <div class="rounded-2xl bg-white dark:bg-slate-900 p-5 sm:p-6 border border-slate-200 dark:border-slate-800 shadow-xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">1. Pilih Contoh Transaksi Bisnis</h2>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Klik tombol transaksi di bawah untuk mencatatnya ke dalam tabel analisis persamaan dasar akuntansi.</p>
            </div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 self-start">8 Skenario Siap Pakai</span>
          </div>

          <div id="sim-presets-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Custom Transaction Builder -->
        <div class="rounded-2xl bg-slate-100/80 dark:bg-slate-900/80 p-5 sm:p-6 border border-slate-200 dark:border-slate-800 space-y-4">
          <h2 class="text-base font-extrabold text-slate-900 dark:text-white flex items-center gap-2">
            <span>➕</span> Buat Transaksi Sendiri (Simulasi Bebas)
          </h2>
          <form onsubmit="handleCustomTransaction(event)" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 dark:text-slate-300 mb-1">Jenis Transaksi</label>
              <select id="custom-tx-type" class="w-full rounded-xl px-3 py-2.5 text-sm bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 focus:ring-2 focus:ring-emerald-500 outline-none">
